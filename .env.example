# Copy to .env and fill in. Never commit the populated file.

# --- A-MEM's own LLM backend (the system under test) ---
# LiteLLM model-id string, e.g. ollama/llama3.1:70b, nvidia_nim/meta/llama-3.1-70b-instruct,
# anthropic/claude-sonnet-5
AMEM_LLM_MODEL=ollama/llama3.1:70b
AMEM_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- GEPA optimization roles ---
# task_lm: runs the many rollouts during search — prefer a cheap/local model
GEPA_TASK_LM=ollama/llama3.1:8b
# reflection_lm: diagnoses failures and proposes new prompts — prefer a stronger model
GEPA_REFLECTION_LM=anthropic/claude-opus-4-8

# --- Provider endpoints/credentials ---
OLLAMA_API_BASE=http://localhost:11434
NVIDIA_NIM_API_KEY=
ANTHROPIC_API_KEY=

# --- GEPA run controls ---
GEPA_MAX_METRIC_CALLS=150

# --- Paper reproduction (docs/decisions/0013, `just reproduce`) ---
# Uses WujiangXu/AgenticMemory's own backend/model naming, NOT LiteLLM-style
# prefixed strings -- bare model name only, e.g. llama3.2:1b, qwen2.5:3b,
# gpt-4o-mini. backend is one of: openai, ollama, sglang, vllm.
PAPER_REPRO_BACKEND=ollama
PAPER_REPRO_MODEL=llama3.2:1b
